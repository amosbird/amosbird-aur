# Maintainer: Kalle Lindqvist <kalle.lindqvist@mykolab.com>
pkgname=xkeysnail-git
pkgver=99999.r109.t1743861732.g8f359b7
pkgrel=1
pkgdesc="Yet another keyboard remapping tool for X environment."
arch=('any')
url="https://github.com/amosbird/xkeysnail"
license=('GPL')
depends=('python')
makedepends=('python-build'
             'python-installer'
             'python-setuptools'
             'python-wheel'
             'git')
provides=('xkeysnail')
conflicts=('xkeysnail')
source=("git+https://github.com/amosbird/xkeysnail.git")
md5sums=("SKIP")
_gitname="xkeysnail"

pkgver() {
    cd "$srcdir/$_gitname"
    printf "99999.r%s.t%s.g%s" \
        "$(git rev-list --count HEAD)" \
        "$(git show -s --format=%ct HEAD)" \
        "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$_gitname"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$_gitname"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
